# Kafe Lilim environment variables

# Required for staff session security. Use a strong value in production.
SESSION_SECRET=change-this-secret

# Shared staff passcode used when no individual staff accounts are configured.
STAFF_PASSCODE=change-me

# Optional: configure individual accounts with roles in JSON format.
# Example: [{"name":"Owner","role":"owner","passcode":"owner123"},{"name":"Barista","role":"employee","passcode":"barista123"}]
# Leave empty to use the single shared passcode mode.
STAFF_ACCOUNTS=

# Optional production flag for secure cookies.
NODE_ENV=development

# Session expiry in minutes.
SESSION_TTL_MINUTES=120
